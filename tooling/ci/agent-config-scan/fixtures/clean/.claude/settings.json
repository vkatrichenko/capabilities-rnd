{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "bash .claude/hooks/lint.sh" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit", "hooks": [{ "type": "command", "command": "INPUT=$(cat); FILE=$(echo \"$INPUT\" | jq -r '.tool_input.file_path // empty'); if [ -z \"$FILE\" ]; then exit 0; fi; npx prettier --check \"$FILE\"" }] }
    ]
  },
  "permissions": { "allow": ["Bash(git status:*)", "Read(//tmp/**)"] },
  "enabledPlugins": { "awos@awos-marketplace": true },
  "extraKnownMarketplaces": {
    "awos-marketplace": { "source": { "source": "github", "repo": "example/awos", "ref": "v1.4.0" } }
  }
}
